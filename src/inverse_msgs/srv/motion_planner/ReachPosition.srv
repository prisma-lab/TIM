geometry_msgs/PoseStamped desired_pos   # configuration to reach
float64 max_vel 0.25                    # maximum velocity in m/s
# True cancels planned motions and executes immediately; false appends to the queue.
bool immediate_execution false
---
bool success
# Execution order. IDs are unique across requests; the first starts this motion
# and the last finishes it on /motion_start and /motion_end (decimal strings).
uint64[] motion_ids
