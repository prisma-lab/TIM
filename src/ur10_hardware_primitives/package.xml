<?xml version="1.0"?>
<package format="3">
  <name>ur10_hardware_primitives</name>
  <version>0.1.0</version>
  <description>UR10 CB3 and USB Robotiq 2F-140 primitives using measured hardware feedback.</description>
  <maintainer email="yigit.yildirim@bogazici.edu.tr">Yigit Yildirim</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>primitive_manager</depend><depend>pluginlib</depend>
  <depend>rclcpp</depend><depend>rclcpp_action</depend><depend>control_msgs</depend>
  <depend>sensor_msgs</depend><depend>geometry_msgs</depend><depend>trajectory_msgs</depend>
  <depend>moveit_msgs</depend><depend>tf2_ros</depend><depend>tf2_geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <exec_depend>rclpy</exec_depend><exec_depend>rcl_interfaces</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend><exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend><exec_depend>ur_description</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend><exec_depend>robotiq_driver</exec_depend>
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>gripper_controllers</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend><exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend><exec_depend>moveit_simple_controller_manager</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
