<?xml version="1.0"?>
<robot name="blue_peg">
  <link name="peg_link">
    <visual>
      <geometry><cylinder radius="0.015" length="0.1"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <gazebo reference="peg_link">
    <material>Gazebo/Blue</material>
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
  </gazebo>
</robot>
