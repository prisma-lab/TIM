<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur10_peg_task">

  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur10"/>
  <xacro:arg name="sim_gazebo" default="true"/>
  <xacro:arg name="simulation_controllers" default="$(find use_case_sim)/config/task_controllers.yaml"/>

  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>

  <joint name="world_to_table" type="fixed"><parent link="world"/><child link="table_link"/><origin xyz="0.7 0 0" rpy="0 0 0"/></joint>
  <link name="table_link">
    <visual><origin xyz="0 0 0.775"/><geometry><box size="0.6 1.0 0.05"/></geometry><material name="wood"><color rgba="0.6 0.4 0.2 1"/></material></visual>
    <collision><origin xyz="0 0 0.775"/><geometry><box size="0.6 1.0 0.05"/></geometry></collision>
    <visual><origin xyz="0.25 0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry><material name="wood"/></visual>
    <collision><origin xyz="0.25 0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry></collision>
    <visual><origin xyz="-0.25 0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry><material name="wood"/></visual>
    <collision><origin xyz="-0.25 0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry></collision>
    <visual><origin xyz="0.25 -0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry><material name="wood"/></visual>
    <collision><origin xyz="0.25 -0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry></collision>
    <visual><origin xyz="-0.25 -0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry><material name="wood"/></visual>
    <collision><origin xyz="-0.25 -0.45 0.375"/><geometry><cylinder radius="0.02" length="0.75"/></geometry></collision>
    <inertial><origin xyz="0 0 0.4"/><mass value="20"/><inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/></inertial>
  </link>

  <joint name="table_to_prism1" type="fixed"><parent link="table_link"/><child link="prism1_link"/><origin xyz="0 0.15 0.85" rpy="0 0 0"/></joint>
  <link name="prism1_link">
    <visual><geometry><box size="0.2 0.2 0.1"/></geometry><material name="white"><color rgba="0.9 0.9 0.9 1"/></material></visual>
    <collision><geometry><box size="0.2 0.2 0.1"/></geometry></collision>
    <inertial><mass value="5"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
  </link>

  <joint name="table_to_prism2" type="fixed"><parent link="table_link"/><child link="prism2_link"/><origin xyz="0 -0.15 0.85" rpy="0 0 0"/></joint>
  <link name="prism2_link">
    <visual><geometry><box size="0.2 0.2 0.1"/></geometry><material name="white"><color rgba="0.9 0.9 0.9 1"/></material></visual>
    <collision><geometry><box size="0.2 0.2 0.1"/></geometry></collision>
    <inertial><mass value="5"/><inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/></inertial>
  </link>

  <joint name="table_to_plate" type="fixed">
    <parent link="table_link"/>
    <child link="rear_plate_link"/>
    <origin xyz="0 -0.26 0.85" rpy="0 0 0"/>
  </joint>

  <link name="rear_plate_link">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.2 0.02 0.1"/></geometry><material name="grey"><color rgba="0.3 0.3 0.3 1"/></material></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.2 0.02 0.1"/></geometry></collision>
    
    <visual><origin xyz="0 0 0.075"/><geometry><box size="0.2 0.02 0.05"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.075"/><geometry><box size="0.2 0.02 0.05"/></geometry></collision>

    <visual><origin xyz="0.06 0 0.125"/><geometry><box size="0.08 0.02 0.05"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0.06 0 0.125"/><geometry><box size="0.08 0.02 0.05"/></geometry></collision>

    <visual><origin xyz="-0.06 0 0.125"/><geometry><box size="0.08 0.02 0.05"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="-0.06 0 0.125"/><geometry><box size="0.08 0.02 0.05"/></geometry></collision>

    <visual><origin xyz="0 0 0.175"/><geometry><box size="0.2 0.02 0.05"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.175"/><geometry><box size="0.2 0.02 0.05"/></geometry></collision>

    <inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>

  <gazebo reference="table_link"><material>Gazebo/Wood</material></gazebo>
  <gazebo reference="prism1_link"><material>Gazebo/White</material></gazebo>
  <gazebo reference="prism2_link"><material>Gazebo/White</material></gazebo>
  <gazebo reference="rear_plate_link"><material>Gazebo/DarkGrey</material></gazebo>

  <joint name="world_to_camera" type="fixed">
    <parent link="world"/>
    <child link="camera_link"/>
    <origin xyz="2.0 0 2.5" rpy="0 0.9 3.14159"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.03 0.12 0.03"/></geometry><material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><geometry><box size="0.03 0.12 0.03"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_optical_frame"/>

  <gazebo reference="camera_link">
    <material>Gazebo/FlatBlack</material>
    <sensor type="depth" name="zed2_camera_sensor">
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.5</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>zed2</namespace>
        </ros>
        <frame_name>camera_optical_frame</frame_name>
        <min_depth>0.2</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>
  <xacro:robotiq_gripper name="RobotiqGripper" prefix="" parent="tool0" include_ros2_control="false">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

  <ros2_control name="RobotiqGripperHardware" type="system">
    <hardware><plugin>gazebo_ros2_control/GazeboSystem</plugin></hardware>
    <joint name="robotiq_85_left_knuckle_joint"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.0</param></state_interface><state_interface name="velocity"/></joint>
    <joint name="robotiq_85_right_knuckle_joint"><param name="mimic">robotiq_85_left_knuckle_joint</param><param name="multiplier">1.0</param><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="robotiq_85_left_inner_knuckle_joint"><param name="mimic">robotiq_85_left_knuckle_joint</param><param name="multiplier">1.0</param><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="robotiq_85_right_inner_knuckle_joint"><param name="mimic">robotiq_85_left_knuckle_joint</param><param name="multiplier">1.0</param><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="robotiq_85_left_finger_tip_joint"><param name="mimic">robotiq_85_left_knuckle_joint</param><param name="multiplier">-1.0</param><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="robotiq_85_right_finger_tip_joint"><param name="mimic">robotiq_85_left_knuckle_joint</param><param name="multiplier">-1.0</param><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
</robot>
